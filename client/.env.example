# Copy this to client/.env and fill in the real values before running `npm run build`
# Vite root is set to client/, so it reads env files from client/.env (not the project root)

VITE_CLERK_PUBLISHABLE_KEY="pk_live_..."
VITE_STRIPE_PUBLISHABLE_KEY="pk_live_..."
VITE_HCAPTCHA_SITE_KEY="..."

# Google Sign-In (native Android via @capgo/capacitor-social-login)
# Web Application OAuth 2.0 Client ID from Google Cloud Console.
# Same credential entered in Clerk Dashboard → Social connections → Google → custom credentials.
VITE_GOOGLE_WEB_CLIENT_ID="xxxxxx.apps.googleusercontent.com"
