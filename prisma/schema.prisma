generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int       @id @default(autoincrement())
  email            String    @unique
  last_signed_in_at DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  @@map("users")
}

model ZodiacSign {
  id           Int      @id @default(autoincrement())
  name_italian String
  name_english String   @unique
  date_range   String
  symbol       String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  horoscope_data        HoroscopeData[]
  weekly_horoscope_data WeeklyHoroscopeData[]

  @@map("zodiac_signs")
}

model Source {
  id               Int      @id @default(autoincrement())
  name             String
  domain           String   @unique
  logo_url         String?
  base_url         String
  url_pattern      String
  reliability_score Decimal  @db.Decimal(3, 2) @default(3.0)
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  horoscope_data HoroscopeData[]

  @@map("sources")
}

model HoroscopeData {
  id               Int      @id @default(autoincrement())
  source_id        Int
  zodiac_sign_id   Int
  date             DateTime @db.Date
  original_text    String   @db.Text
  summary          String?
  superquote       String?
  relazioni_rating Int?      @db.SmallInt
  lavoro_rating    Int?      @db.SmallInt
  salute_rating    Int?      @db.SmallInt
  tone_analysis    String?   // 'positive', 'neutral', 'negative'
  original_url     String   @db.Text
  scraped_at       DateTime
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  source      Source     @relation(fields: [source_id], references: [id])
  zodiac_sign ZodiacSign @relation(fields: [zodiac_sign_id], references: [id])

  @@unique([source_id, zodiac_sign_id, date])
  @@index([date])
  @@map("horoscope_data")
}

model WeeklySource {
  id               Int      @id @default(autoincrement())
  name             String
  domain           String   @unique
  logo_url         String?
  base_url         String
  url_pattern      String
  reliability_score Decimal  @db.Decimal(3, 2) @default(3.0)
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  weekly_horoscope_data WeeklyHoroscopeData[]

  @@map("weekly_sources")
}

model WeeklyHoroscopeData {
  id               Int      @id @default(autoincrement())
  source_id        Int
  zodiac_sign_id   Int
  week_start_date  DateTime @db.Date
  original_text    String   @db.Text
  summary          String   @db.Text
  relazioni_rating Int      @db.SmallInt
  lavoro_rating    Int      @db.SmallInt
  salute_rating    Int      @db.SmallInt
  tone_analysis    String   // 'positive', 'neutral', 'negative'
  original_url     String   @db.Text
  scraped_at       DateTime
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  source      WeeklySource @relation(fields: [source_id], references: [id])
  zodiac_sign ZodiacSign   @relation(fields: [zodiac_sign_id], references: [id])

  @@unique([source_id, zodiac_sign_id, week_start_date])
  @@index([week_start_date])
  @@map("weekly_horoscope_data")
}