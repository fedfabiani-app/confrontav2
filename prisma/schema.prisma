generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    Int       @id @default(autoincrement())
  email                 String    @unique
  clerkId               String?   @unique
  tier                  String    @default("free")
  stripe_customer_id    String?   @unique
  last_signed_in_at     DateTime?
  push_token            String?
  push_token_updated_at DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  preferences              UserPreferences?
  notification_preferences UserNotificationPreference[]

  @@map("users")
}

model ZodiacSign {
  id           Int      @id @default(autoincrement())
  name_italian String
  name_english String   @unique
  date_range   String
  symbol       String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  horoscope_data                HoroscopeData[]
  weekly_horoscope_data         WeeklyHoroscopeData[]
  scraper_source_statuses       ScraperSourceStatus[]
  weekly_scraper_source_statuses WeeklyScraperSourceStatus[]
  notification_preferences      UserNotificationPreference[]

  @@map("zodiac_signs")
}

model Source {
  id               Int      @id @default(autoincrement())
  name             String
  domain           String   @unique
  logo_url         String?
  base_url         String
  url_pattern      String
  reliability_score Decimal  @db.Decimal(3, 2) @default(3.0)
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  horoscope_data HoroscopeData[]
  scraper_source_statuses ScraperSourceStatus[]

  @@map("sources")
}

model WeeklySource {
  id               Int      @id @default(autoincrement())
  name             String
  domain           String   @unique
  logo_url         String?
  base_url         String
  url_pattern      String   // For pattern: URL template. For archive: archive page path
  archive_url      String?  // Archive page URL for archive-based scraping
  scrape_strategy  String   @default("pattern") // 'pattern' or 'archive'
  slug             String?  // Source identifier for source group classification
  reliability_score Decimal  @db.Decimal(3, 2) @default(3.0)
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  weekly_horoscope_data WeeklyHoroscopeData[]
  weekly_scraper_source_statuses WeeklyScraperSourceStatus[]

  @@map("weekly_sources")
}

model HoroscopeData {
  id               Int      @id @default(autoincrement())
  source_id        Int
  zodiac_sign_id   Int
  date             DateTime @db.Date
  original_text    String   @db.Text
  superquote       String?  @db.VarChar(180)
  summary          String   @db.Text
  relazioni_rating Int      @db.SmallInt
  lavoro_rating    Int      @db.SmallInt
  salute_rating    Int      @db.SmallInt
  tone_analysis    String   // 'positive', 'neutral', 'negative'
  original_url     String   @db.Text
  scraped_at       DateTime
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  source      Source     @relation(fields: [source_id], references: [id])
  zodiac_sign ZodiacSign @relation(fields: [zodiac_sign_id], references: [id])

  @@unique([source_id, zodiac_sign_id, date])
  @@index([date])
  @@map("horoscope_data")
}

model WeeklyHoroscopeData {
  id               Int      @id @default(autoincrement())
  source_id        Int
  zodiac_sign_id   Int
  week_start_date  DateTime @db.Date
  original_text    String   @db.Text
  superquote       String?  @db.VarChar(180)
  summary          String   @db.Text
  relazioni_rating Int      @db.SmallInt
  lavoro_rating    Int      @db.SmallInt
  salute_rating    Int      @db.SmallInt
  tone_analysis    String   // 'positive', 'neutral', 'negative'
  original_url     String   @db.Text
  scraped_at       DateTime
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  weekly_source WeeklySource @relation(fields: [source_id], references: [id])
  zodiac_sign   ZodiacSign   @relation(fields: [zodiac_sign_id], references: [id])

  @@unique([source_id, zodiac_sign_id, week_start_date])
  @@index([week_start_date])
  @@map("weekly_horoscope_data")
}

model UserPreferences {
  id                Int      @id @default(autoincrement())
  user_id           Int      @unique
  favorite_signs    String[] // Array of zodiac sign slugs
  favorite_sources  String[] // Array of source IDs (as strings)
  notifications_enabled Boolean @default(true)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id])

  @@map("user_preferences")
}

model CleanupTracker {
  id           Int      @id @default(autoincrement())
  last_cleanup DateTime @default(now())

  @@map("cleanup_tracker")
}

model ScraperExecution {
  id                  Int       @id @default(autoincrement())
  started_at          DateTime  @default(now())
  completed_at        DateTime?
  status              String    // 'running', 'completed', 'failed', 'cancelled'
  target_date         DateTime  @db.Date
  total_jobs_enqueued Int       @default(0)
  successful_jobs     Int       @default(0)
  failed_jobs         Int       @default(0)
  retry_cycle_count   Int       @default(0)
  trigger_type        String    // 'scheduled', 'manual'
  error_message       String?   @db.Text

  source_statuses ScraperSourceStatus[]

  @@index([target_date, started_at])
  @@index([status, started_at])
  @@map("scraper_executions")
}

model ScraperSourceStatus {
  id               Int       @id @default(autoincrement())
  execution_id     Int
  source_id        Int
  zodiac_sign_id   Int
  target_date      DateTime  @db.Date
  status           String    // 'pending', 'processing', 'success', 'failed', 'skipped'
  attempt_count    Int       @default(0)
  last_attempted_at DateTime?
  completed_at     DateTime?
  error_message    String?   @db.Text
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  execution   ScraperExecution @relation(fields: [execution_id], references: [id], onDelete: Cascade)
  source      Source           @relation(fields: [source_id], references: [id], onDelete: Cascade)
  zodiac_sign ZodiacSign       @relation(fields: [zodiac_sign_id], references: [id], onDelete: Cascade)

  @@unique([source_id, zodiac_sign_id, target_date])
  @@index([target_date, status])
  @@index([execution_id, status])
  @@map("scraper_source_status")
}

model ScraperConfig {
  id                       Int      @id @default(autoincrement())
  scraper_type             String   @unique @default("daily") // 'daily' or 'weekly'
  enabled                  Boolean  @default(false)
  start_time               String   @default("05:30:00") // TIME format HH:MM:SS
  end_time                 String   @default("08:00:00")
  interval_minutes         Int      @default(20)
  max_retries_per_source   Int      @default(3)
  auto_retry_delay_minutes Int      @default(10)
  skip_already_processed   Boolean  @default(true)
  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt

  @@map("scraper_config")
}

model WeeklyScraperExecution {
  id                  Int       @id @default(autoincrement())
  started_at          DateTime  @default(now())
  completed_at        DateTime?
  status              String    // 'running', 'completed', 'failed', 'cancelled'
  target_week         DateTime  @db.Date // Always Monday
  source_group        String    // 'all', 'elle_only', 'saturday_group'
  total_jobs_enqueued Int       @default(0)
  successful_jobs     Int       @default(0)
  failed_jobs         Int       @default(0)
  trigger_type        String    // 'scheduled', 'manual', 'fallback'
  error_message       String?   @db.Text

  source_statuses WeeklyScraperSourceStatus[]

  @@index([target_week, started_at])
  @@index([status, started_at])
  @@index([source_group, target_week])
  @@map("weekly_scraper_executions")
}

model WeeklyScraperSourceStatus {
  id               Int       @id @default(autoincrement())
  execution_id     Int
  source_id        Int
  zodiac_sign_id   Int
  target_week      DateTime  @db.Date // Always Monday
  status           String    // 'pending', 'processing', 'success', 'failed', 'skipped'
  attempt_count    Int       @default(0)
  last_attempted_at DateTime?
  completed_at     DateTime?
  error_message    String?   @db.Text
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  execution   WeeklyScraperExecution @relation(fields: [execution_id], references: [id], onDelete: Cascade)
  source      WeeklySource           @relation(fields: [source_id], references: [id], onDelete: Cascade)
  zodiac_sign ZodiacSign             @relation(fields: [zodiac_sign_id], references: [id], onDelete: Cascade)

  @@unique([source_id, zodiac_sign_id, target_week])
  @@index([target_week, status])
  @@index([execution_id, status])
  @@map("weekly_scraper_source_status")
}


model UserNotificationPreference {
  id                   Int        @id @default(autoincrement())
  user_id              Int
  sign_id              Int
  daily                Boolean    @default(true)
  weekly               Boolean    @default(true)
  notify_time          String     @default("08:00")
  timezone             String     @default("Europe/Rome")
  last_daily_sent_at   DateTime?
  last_weekly_sent_at  DateTime?
  created_at           DateTime   @default(now())
  updated_at           DateTime   @updatedAt

  user  User       @relation(fields: [user_id], references: [id])
  sign  ZodiacSign @relation(fields: [sign_id], references: [id])

  @@unique([user_id, sign_id])
  @@map("user_notification_preferences")
}

model CompatibilityResult {
  id          Int      @id @default(autoincrement())
  sign1       String   // English, sorted alphabetically (sign1 < sign2)
  sign2       String
  period_type String   // 'daily' | 'weekly'
  period_date DateTime @db.Date
  result      String   @db.Text
  created_at  DateTime @default(now())

  @@unique([sign1, sign2, period_type, period_date])
  @@index([period_type, period_date])
  @@map("compatibility_results")
}
