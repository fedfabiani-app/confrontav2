generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int       @id @default(autoincrement())
  email            String    @unique
  last_signed_in_at DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  preferences UserPreferences?

  @@map("users")
}

model ZodiacSign {
  id           Int      @id @default(autoincrement())
  name_italian String
  name_english String   @unique
  date_range   String
  symbol       String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  horoscope_data HoroscopeData[]

  @@map("zodiac_signs")
}

model Source {
  id               Int      @id @default(autoincrement())
  name             String
  domain           String   @unique
  logo_url         String?
  base_url         String
  url_pattern      String
  reliability_score Decimal  @db.Decimal(3, 2) @default(3.0)
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  horoscope_data HoroscopeData[]

  @@map("sources")
}

model WeeklySource {
  id               Int      @id @default(autoincrement())
  name             String
  domain           String   @unique
  logo_url         String?
  base_url         String
  url_pattern      String
  reliability_score Decimal  @db.Decimal(3, 2) @default(3.0)
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@map("weekly_sources")
}

model HoroscopeData {
  id               Int      @id @default(autoincrement())
  source_id        Int
  zodiac_sign_id   Int
  date             DateTime @db.Date
  original_text    String   @db.Text
  superquote       String?  @db.VarChar(80)
  summary          String   @db.Text
  relazioni_rating Int      @db.SmallInt
  lavoro_rating    Int      @db.SmallInt
  salute_rating    Int      @db.SmallInt
  tone_analysis    String   // 'positive', 'neutral', 'negative'
  original_url     String   @db.Text
  scraped_at       DateTime
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  source      Source     @relation(fields: [source_id], references: [id])
  zodiac_sign ZodiacSign @relation(fields: [zodiac_sign_id], references: [id])

  @@unique([source_id, zodiac_sign_id, date])
  @@index([date])
  @@map("horoscope_data")
}

model UserPreferences {
  id                Int      @id @default(autoincrement())
  user_id           Int      @unique
  favorite_signs    String[] // Array of zodiac sign IDs
  notifications_enabled Boolean @default(true)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id])

  @@map("user_preferences")
}
