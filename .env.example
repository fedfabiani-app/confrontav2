# Database Configuration
DATABASE_URL="mysql://username:password@localhost:3306/oroscopo_italiano"

# Anthropic Configuration
ANTHROPIC_API_KEY="your_anthropic_api_key_here"

# Scraping Configuration
SCRAPE_USER_AGENT="ItalianHoroscopeComparatorBot/1.0 (+contact@yourdomain.com)"

# Environment
NODE_ENV="development"
TZ="Europe/Rome"

# Server Configuration
PORT="5000"
BASE_URL_BACKEND="http://localhost:5000"
BASE_URL_FRONTEND="http://localhost:5000"

# Session Configuration (auto-generated if not provided)
SESSION_SECRET="your_session_secret_here"

# Optional: Rate Limiting
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"

# Optional: Job Queue Configuration
SCRAPE_QUEUE_CONCURRENCY="3"
NLP_QUEUE_CONCURRENCY="2"
DOMAIN_DELAY_MS="2000"

# Optional: Retry Configuration
MAX_SCRAPING_RETRIES="3"
MAX_AI_RETRIES="3"

# Optional: Cache Configuration
CACHE_TTL_SECONDS="3600"

# Daily Scraper Configuration
# Required to use admin/cleanup endpoints (X-Admin-Secret header) - without it they reject all requests.
# Generate a strong random value, e.g.: openssl rand -hex 32
ADMIN_SECRET=""
SCRAPER_TIMEZONE="Europe/Rome"

# Stripe Configuration
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Clerk Configuration
VITE_CLERK_PUBLISHABLE_KEY="VITE_CLERK_PUBLISHABLE_KEY=pk_test_aG9uZXN0LWxpb24tODEuY2xlcmsuYWNjb3VudHMuZGV2JA) "

# Email (Resend)
RESEND_API_KEY=""

# hCaptcha
HCAPTCHA_SECRET_KEY=""
VITE_HCAPTCHA_SITE_KEY=""

# Firebase Push Notifications (Firebase Admin SDK)
# Get these from Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Google Sign-In (native Android — @capgo/capacitor-social-login)
# Web Application OAuth 2.0 Client ID and Secret from Google Cloud Console.
# Used by /api/native-google-auth to verify the audience of Google ID tokens.
GOOGLE_WEB_CLIENT_ID="xxxxxx.apps.googleusercontent.com"

# Capacitor Native App
# Set CAPACITOR_SERVER_URL to Railway production URL when building the native app with server.url mode.
# When set, the WebView loads directly from this URL (simplest fix for API routing).
# Leave empty to serve from bundled dist/public and rely on VITE_API_BASE_URL instead.
CAPACITOR_SERVER_URL=""
# Set VITE_API_BASE_URL to Railway URL when building without server.url mode.
# This prefixes all fetch('/api/...') calls made through queryClient.ts.
# Example: VITE_API_BASE_URL=https://your-app.railway.app npm run cap:build
VITE_API_BASE_URL=""
